// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
  {
    "label": "@lair/ui storybook",
    "command": "npx nx storybook @lair/ui",
    "reveal": "never"
  },
  {
    "label": "@lair/ui-archive storybook",
    "command": "npx nx storybook @lair/ui-archive",
    "reveal": "never"
  },
  {
    "label": "affected checks",
    "command": "npx nx affected -t typecheck test build",
    "hide": "on_success"
  },
  {
    "label": "lint fix",
    "command": "npx nx run-many -t lint -- --fix",
    "hide": "on_success"
  },
  {
    "label": "format",
    "command": "npx nx format",
    "hide": "on_success"
  },
  {
    "label": "host tasks",
    "command": "npx http-server docs/planning/running-mode/tasks -a 0.0.0.0 -p 4173 -c-1"
  }
]
