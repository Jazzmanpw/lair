import type {Preview} from '@storybook/react-vite';
import {QueryClient, QueryClientProvider} from '@tanstack/react-query';
import i18next from 'i18next';
import {I18nextProvider} from 'react-i18next';
import {initI18n} from '@omni/i18n';
import {mockFlags} from '@omni/storybook-helpers/ld-mock';
import {SnackbarContextProvider} from '@omni/ui-kit/snackbar-context-provider';
import ThemeProvider from '@omni/ui-kit/theme-provider';

const queryClient = new QueryClient({
  defaultOptions: {
    queries: {
      throwOnError: true,
    },
  },
});

const preview: Preview = {
  decorators: [
    (Story, {id, parameters: {query}}) => (
      <I18nextProvider i18n={i18next} defaultNS={id}>
        <QueryClientProvider client={query!.queryClient!}>
          <ThemeProvider>
            <SnackbarContextProvider>
              <Story />
            </SnackbarContextProvider>
          </ThemeProvider>
        </QueryClientProvider>
      </I18nextProvider>
    ),
  ],
  async beforeAll() {
    await initI18n();
  },
  beforeEach: [
    mockFlags,
    ({canvasElement}) => {
      // fix id missing in Vitest's playwright browser environment
      if (!canvasElement.id) {
        canvasElement.id = 'storybook-root';
      }
    },
    ({parameters}) => {
      // prevent cache from being shared when you navigate from one story to another
      parameters.query!.queryClient!.clear();
    },
    ({id, parameters}) => {
      if (parameters.i18n?.translation) {
        // We remove-then-add instead of using a beforeEach cleanup callback because
        // Storybook can fire cleanup from render N *after* render N+1's beforeEach has
        // already added fresh resources, deleting what the current render needs.
        // This happens on initial load when renderSelection is called twice in quick
        // succession (HMR, manager sync) and the first render's teardown races with
        // the second render's mount.
        i18next.removeResourceBundle('en', id);
        i18next.addResourceBundle('en', id, parameters.i18n.translation);
      }
    },
  ],
  parameters: {
    viewport: {
      options: {
        desktop: {
          name: 'Desktop',
          styles: {width: '1280px', height: '800px'},
          type: 'desktop',
        },
        fhdDesktop: {
          name: 'FullHD desktop',
          styles: {width: '1920px', height: '980px'},
          type: 'desktop',
        },
      },
    },
    a11y: {test: 'todo'},
    query: {queryClient},
  },
  initialGlobals: {
    viewport: {value: 'desktop'},
  },
};

export default preview;
