{
  "extends": "<%= relativeToRoot %>tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "<%= relativeToRoot %>dist/types/<%= name %>/tsconfig.lib.tsbuildinfo",
    "outDir": "<%= relativeToRoot %>dist/types/<%= name %>",
    "rootDir": "<% if (type === 'react' && !skipStorybook) { %>.<% } else { %>./src<% } %>",
    "emitDeclarationOnly": true<% if (type === 'react') { %>,
    "jsx": "react-jsx"<% } %><% if (type === 'node') { %>,
    "types": ["node"]<% } %>
  },
  "include": ["src"<% if (type === 'react' && !skipStorybook) { %>, ".storybook/preview.tsx"<% } %>]
}
